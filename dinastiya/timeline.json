  "end": 142.7588888888889,
  "text": "*Концерты* из *Москвы*,",
  "section": "chorus3",
  "pal": 1,
  "special": false
 },
 {
  "start": 142.7588888888889,
  "end": 144.475,
  "text": "мы пишем это на *Samson*",
  "section": "chorus3",
  "pal": 2,
